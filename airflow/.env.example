# Copy to airflow/.env (gitignored); `astro dev start` injects these into every container.
EIA_API_KEY=
GRIDLENS_STORAGE=s3
GRIDLENS_S3_BUCKET=gridlens-raw-<your-suffix>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
SNOWFLAKE_USER=GRIDLENS_SVC
SNOWFLAKE_WAREHOUSE=GRIDLENS_WH
# PEM with literal \n line breaks (read by gridlens.common.snowflake) ...
SNOWFLAKE_PRIVATE_KEY=
# ... and a file path for dbt. Put rsa_key.p8 in airflow/include/ (gitignored).
SNOWFLAKE_PRIVATE_KEY_PATH=/usr/local/airflow/include/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

SLACK_WEBHOOK_URL=
GRIDLENS_BACKTEST_DAYS=14

# Parsing safety margin (the DAG renders from a manifest, so it is normally fast)
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=120
AIRFLOW__DAG_PROCESSOR__DAG_FILE_PROCESSOR_TIMEOUT=180
