# Copy to .env and fill in. Never commit .env.

# --- EIA API v2 (free key: https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# --- Storage backend for raw landing: "s3" or "local" (local writes to ./data/raw)
GRIDLENS_STORAGE=local
GRIDLENS_S3_BUCKET=gridlens-raw-<your-suffix>
GRIDLENS_LOCAL_ROOT=./data/raw
AWS_PROFILE=default
AWS_REGION=us-east-1

# --- Ingestion behaviour
# Days to re-pull behind the watermark (EIA revises recent hours).
GRIDLENS_LOOKBACK_DAYS=3
# First date pulled when there is no watermark yet.
GRIDLENS_BACKFILL_START=2024-01-01

# --- Snowflake (key-pair auth; password-only auth is deprecated for service users)
SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
SNOWFLAKE_USER=GRIDLENS_SVC
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=GRIDLENS_WH
SNOWFLAKE_PRIVATE_KEY_PATH=./rsa_key.p8
# Or the PEM contents directly (CI / Airflow):
# SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# dbt dev schema suffix (DEV.DBT_<you>)
DBT_USER=ankit

# --- Alerts (optional)
SLACK_WEBHOOK_URL=

# --- Forecast job / dashboard
GRIDLENS_FEATURES_TABLE=ANALYTICS.MARTS.ML_DEMAND_FEATURES
GRIDLENS_ML_DATABASE=ANALYTICS
GRIDLENS_ML_SCHEMA=ML
GRIDLENS_MARTS=ANALYTICS.MARTS
