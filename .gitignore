# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Secrets / local config
.env
*.p8
*.pem
rsa_key*

# Local data lake (storage backend = local)
data/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
